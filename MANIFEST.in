include LICENSE
include README.md
include pyproject.toml
recursive-include plugins/claude *
recursive-include studio *.json *.js *.mjs *.css *.html *.md *.rs *.toml *.svg *.png *.ico

# Release archives should not ship local proof fixtures, build products, or
# historical auxiliary applications. Runtime packages are included by setuptools.
prune tests
prune testing
prune build
prune dist
prune examples
prune scripts
prune codex-marketplace
prune .release-dist
prune studio/node_modules
prune studio/dist
prune studio/src-tauri/target

global-exclude __pycache__
global-exclude *.py[cod]
